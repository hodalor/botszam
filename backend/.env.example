NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string
MONGODB_URI=7

# At least 32 random characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d

# Local: "lax". On Render set "none" (production also forces SameSite=None + Secure).
COOKIE_SAMESITE=lax

# Exact origin of the frontend (CORS). No trailing slash.
# Local: http://localhost:5173
# Production: https://your-site.netlify.app
FRONTEND_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Order numbers look like BTZ-261004-4821
ORDER_PREFIX=BTZ

# Used only by `npm run seed` / `npm run seed:prod`
ADMIN_NAME=Botszam Admin
ADMIN_EMAIL=admin@botszam.com
ADMIN_PHONE=0970000000
ADMIN_PASSWORD=change-me-strong-password
